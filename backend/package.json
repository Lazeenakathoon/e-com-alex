{
  "name": "stylehub-backend",
  "version": "1.0.0",
  "private": true,
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon --config nodemon.json server.js"
  },
  "nodemonConfig": {
    "watch": ["server.js", "config", "global"],
    "ignore": ["data/*", ".env*", "node_modules/*", "package-lock.json", "frontend/*"],
    "ext": "js,json"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.18.2",
    "mongodb": "^7.2.0",
    "nodemon": "^3.1.14"
  }
}
